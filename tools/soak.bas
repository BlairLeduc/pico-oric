10 N=0:K=0
20 N=N+1:TEXT:CLS:PAPER N AND 7:INK 7-(N AND 7):GOSUB 200
30 FOR I=2 TO 24:PLOT 1,I,CHR$(1+(I+N)AND 7)+"SOAK"+CHR$(16+(I AND 7))
35 NEXT
40 SOUND 1,50+N MOD 200,0:SOUND 2,300,8:SOUND 3,500,8
45 SOUND 4,20,8:PLAY 7,1,1,2000
50 HIRES:GOSUB 200
60 FOR I=0 TO 20:CURSET 20+RND(1)*190,20+RND(1)*150,1
65 DRAW 9,9,1:CIRCLE 5,1:NEXT
70 GOTO 20
200 A$=KEY$:IF A$<>"" THEN K=ASC(A$)
210 PRINT "C";N;"K";K
220 RETURN
